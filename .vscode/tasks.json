{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ant yahooqt ",
            "type": "shell",
            "command": "/usr/bin/ant -f src/build.xml yahooqt",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
            {
                "owner": "ant",
                "fileLocation": ["relative", "${workspaceFolder}/src"],
                "pattern": [
                    {
                        // "regexp": "\\[javac\\]\\s+(.*):(\\d+):\\s+(warning|error|note):\\s+(.*)",
                        // "regexp": "\\[javac\\]\\s+.*?project[/\\](.*):(\\d+):\\s+(warning|error|note):\\s+(.*)",
                        "regexp": "\\[javac\\]\\s+.*?src\\/build\\/feature-src\\/yahooqt[\\/\\\\](.*):(\\d+):\\s+(warning|error|note):\\s+(.*)",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                ]
            }
            ] 
        },
    ],
}