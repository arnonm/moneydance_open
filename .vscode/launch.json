    "version": "0.2.0",
    "configurations": [
        //java -Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005 -jar myapp.jar
        {
            "type": "java",
            "name": "Attach to Remote Java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "projectName": "MoneyDance" // Optional, but helpful for resolving sources
        },
        // --- OR (easier for local processes) ---
        {
            "type": "java",
            "name": "Attach by Process ID",
            "request": "attach",
            "processId": "${command:PickJavaProcess}", // VS Code will prompt you to select a process
            "projectName": "MoneyDance by ID"
        }
    ]
}